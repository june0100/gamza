# ========================================================
# Git Ignore 설정
# ========================================================

# 환경 변수 및 비밀 키 (절대 커밋 금지)
.env
.env.*
!.env.example

# 의존성 모듈
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 운영체제 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 에디터 및 IDE 설정
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 로그 파일
*.log
