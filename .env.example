# ========================================================
# Supabase 환경 변수 설정 템플릿
# ========================================================
# 주의: 이 파일은 템플릿 예시 파일(.env.example)입니다.
# 실제 비밀 키(service_role, access token)는 절대 공개 저장소에 커밋하지 마세요!
#
# Supabase 콘솔: https://supabase.com/dashboard
# Project Settings -> API에서 발급받으실 수 있습니다.

# Supabase 프로젝트 URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 공개 Anon Key (클라이언트 브라우저용 공개 키)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
